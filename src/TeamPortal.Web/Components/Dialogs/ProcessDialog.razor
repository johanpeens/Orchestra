@* Screen 03. Name, description, business-unit tab strip. Delete sits far left,
   Cancel and Save on the right - per docs/design/03-add-process-modal.png. *@

<MudDialog Class="app-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add Process" : "Edit Process")</MudText>
    </TitleContent>

    <DialogContent>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                @_formError
            </MudAlert>
        }

        <label class="app-field__label" for="proc-name">Process Name *</label>
        <MudTextField @bind-Value="_name"
                      @bind-Value:after="ClearErrors"
                      id="proc-name"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Placeholder="e.g. Gather Document Proofs"
                      Error="@(_nameError is not null)"
                      ErrorText="@_nameError" />

        <label class="app-field__label" for="proc-desc">Process Description</label>
        <MudTextField @bind-Value="_description"
                      @bind-Value:after="ClearErrors"
                      id="proc-desc"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="3"
                      Immediate="true"
                      Placeholder="Describe the workflow, key requirements, and outcomes expected for this process..." />

        @* The units offered here are the organisation's departments - the same
           list the Team screen filters by. Choosing one also sets the coloured
           tag on this process's card in the flow strip. *@
        <label class="app-field__label" id="unit-label">Select Business Unit</label>
        <div class="app-procdialog__units" role="radiogroup" aria-labelledby="unit-label">
            @foreach (var unit in _units)
            {
                var id = unit.Id;

                <button type="button"
                        class="@UnitClass(id)"
                        role="radio"
                        aria-checked="@(_departmentId == id ? "true" : "false")"
                        @onclick="@(() => PickUnit(id))">
                    @unit.Name
                </button>
            }
        </div>
    </DialogContent>

    <DialogActions>
        @if (!IsNew)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="DeleteAsync"
                       Disabled="_saving">
                Delete Process
            </MudButton>
        }

        <MudSpacer />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   OnClick="Cancel"
                   Disabled="_saving"
                   Class="mr-2">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="SaveAsync"
                   Disabled="@(!CanSave)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save Process</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
