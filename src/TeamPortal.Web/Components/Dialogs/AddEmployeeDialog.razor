@* Screen 06. Photo on the left, details on the right, Employee/Management radio.
   Save LEFT, Cancel RIGHT, per Frontend/TeamConventions.md. *@

<MudDialog Class="app-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add Employee" : "Edit Employee")</MudText>
    </TitleContent>

    <DialogContent>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                @_formError
            </MudAlert>
        }

        <div class="app-empdialog">
            <div class="app-empdialog__photo">
                @* justification: decorative placeholder. The name field beside it
                   is what identifies the person being added. *@
                <MudAvatar Size="Size.Large" Class="app-empdialog__avatar" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" />
                </MudAvatar>

                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Disabled="true"
                           Class="app-empdialog__upload">
                    Upload Photo
                </MudButton>
                <MudText Typo="Typo.caption" Class="app-empdialog__hint">
                    Photo upload arrives in phase A10.
                </MudText>
            </div>

            <div class="app-empdialog__fields">
                <label class="app-field__label" for="emp-name">Employee Name*</label>
                <MudTextField @bind-Value="_name"
                              @bind-Value:after="ClearErrors"
                              id="emp-name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Placeholder="e.g. Priya"
                              Error="@(_nameError is not null)"
                              ErrorText="@_nameError" />

                <label class="app-field__label" for="emp-role">Role</label>
                <MudTextField @bind-Value="_jobTitle"
                              @bind-Value:after="ClearErrors"
                              id="emp-role"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Placeholder="e.g. UX/Software Engineer" />

                <label class="app-field__label" for="emp-dept">Department</label>
                <MudSelect @bind-Value="_departmentId"
                           T="int"
                           id="emp-dept"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Error="@(_departmentError is not null)"
                           ErrorText="@_departmentError">
                    @foreach (var department in _departments)
                    {
                        <MudSelectItem T="int" Value="@department.Id">@department.Name</MudSelectItem>
                    }
                </MudSelect>

                <label class="app-field__label" id="stafftype-label">Employee / Management</label>
                <MudRadioGroup @bind-Value="_staffType"
                               T="StaffType"
                               aria-labelledby="stafftype-label">
                    <MudRadio T="StaffType" Value="StaffType.Employee" Color="Color.Primary" Dense="true">
                        Employee
                    </MudRadio>
                    <MudRadio T="StaffType" Value="StaffType.Management" Color="Color.Primary" Dense="true">
                        Management
                    </MudRadio>
                </MudRadioGroup>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="SaveAsync"
                   Disabled="@(!CanSave)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save</span>
            }
        </MudButton>

        <MudSpacer />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   OnClick="Cancel"
                   Disabled="_saving">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>
