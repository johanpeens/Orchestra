@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]

@* The link the login screen has pointed at since phase A4. Deliberately shows
   the same confirmation whether or not the address has an account - see the note
   on IAuthService.RequestPasswordResetAsync. *@

<PageTitle>Forgot your password - Orchestra</PageTitle>

<div class="app-login">

    <aside class="app-login__panel">
        <div class="app-login__brand">
            <AppBrand />
        </div>

        @* Same slot and same class as the sign-in panel's artwork, so the two
           screens behave identically at every window size. *@
        <img class="app-login__art"
             src="ForgotPassword.svg"
             alt=""
             aria-hidden="true"
             width="2424"
             height="1782" />

        <div class="app-login__pitch">
            <h1 class="app-login__pitch-title">It happens to everyone</h1>
            <p class="app-login__pitch-body">
                Tell us the address on your account and we will send a link to set a new
                password. The link works once and expires in 24 hours.
            </p>
        </div>
    </aside>

    <main class="app-login__form-side">
        @if (_sent)
        {
            <div class="app-login__form" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                         Color="Color.Primary"
                         Size="Size.Large"
                         Class="mb-4" />

                <h2 class="app-login__title">Check your inbox</h2>
                <p class="app-login__subtitle">
                    If <b>@_submittedEmail</b> has an account, a reset link is on its way.
                    It works once and expires in 24 hours.
                </p>

                <MudButton Href="/login"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="app-login__submit">
                    Back to sign in
                </MudButton>
            </div>
        }
        else
        {
            <EditForm class="app-login__form" Model="_model" OnValidSubmit="SubmitAsync">
                <h2 class="app-login__title">Reset your password</h2>
                <p class="app-login__subtitle">We will email you a link to set a new one.</p>

                @if (_formError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                        @_formError
                    </MudAlert>
                }

                <label class="app-login__label" for="email">Email Address</label>
                <MudTextField @bind-Value="_model.Email"
                              @bind-Value:after="ClearErrors"
                              id="email"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="name@company.com"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Email"
                              Immediate="true"
                              Error="@(_emailError is not null)"
                              ErrorText="@_emailError"
                              Class="app-login__input"
                              autocomplete="username" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!CanSubmit)"
                           EndIcon="@(_submitting ? null : Icons.Material.Filled.ArrowForward)"
                           Class="app-login__submit">
                    @if (_submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Email Me A Link</span>
                    }
                </MudButton>

                <p class="app-login__footer">
                    Remembered it?
                    <MudLink Href="/login" Color="Color.Primary"><b>Sign in</b></MudLink>
                </p>
            </EditForm>
        }
    </main>

</div>
