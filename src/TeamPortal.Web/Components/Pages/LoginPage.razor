@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@* The one page that must be reachable by someone with no account yet. *@

@* Screen 01. Split layout: dark purple brand panel on the left, form on the
   right. See docs/design/01-login-screen.png. *@

<PageTitle>Sign in - Orchestra</PageTitle>

<div class="app-login">

    <aside class="app-login__panel">
        <div class="app-login__brand">
            <AppBrand />
        </div>

        @* Between the brand and the pitch, and allowed to shrink before either
           of them does - on a short window the words are what matter and the
           drawing is what can afford to go. alt is empty and it is aria-hidden:
           it says nothing the pitch below does not. *@
        <img class="app-login__art"
             src="Login.svg"
             alt=""
             aria-hidden="true"
             width="1161"
             height="973" />

        <div class="app-login__pitch">
            @* The old copy - "orchestrate your enterprise operations in one
               unified workspace" - could have sat on the front of any product
               ever made. It described a category, not this thing.

               This says what actually happens here and keeps the orchestra
               going: you write the music down, and the bot plays from the same
               sheet you did. The last sentence is the honest part, and the one
               that sets the expectation the Chat screen depends on. *@
            <h1 class="app-login__pitch-title">
                Man and bot, playing from the same sheet
            </h1>
            <p class="app-login__pitch-body">
               Map out your real-world ops—every process, every step, every team member. The bot operates on 100% facts and zero assumptions. If it can’t answer a question, you’ve instantly spotted a documentation gap, not an AI guess
            </p>
        </div>
    </aside>

    <main class="app-login__form-side">
        <EditForm class="app-login__form" Model="_model" OnValidSubmit="SignInAsync">
            <h2 class="app-login__title">Welcome to the Orchestra Bot Training Portal</h2>
            <p class="app-login__subtitle">Welcome back! Please enter your details below.</p>

            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                    @_formError
                </MudAlert>
            }

            <label class="app-login__label" for="email">Email Address</label>
            <MudTextField @bind-Value="_model.Email"
                          @bind-Value:after="ClearErrors"
                          id="email"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="name@company.com"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Email"
                          Immediate="true"
                          Error="@(_emailError is not null)"
                          ErrorText="@_emailError"
                          Class="app-login__input"
                          autocomplete="username" />

            <label class="app-login__label" for="password">Password</label>
            <MudTextField @bind-Value="_model.Password"
                          @bind-Value:after="ClearErrors"
                          id="password"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="Enter your password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Lock"
                          Immediate="true"
                          Error="@(_passwordError is not null)"
                          ErrorText="@_passwordError"
                          Class="app-login__input"
                          autocomplete="current-password" />

            <div class="app-login__reveal">
                <MudIconButton Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                               Size="Size.Small"
                               aria-label="@(_showPassword ? "Hide password" : "Show password")"
                               OnClick="TogglePassword" />
            </div>

            <div class="app-login__row">
                <MudCheckBox @bind-Value="_model.RememberMe"
                             T="bool"
                             Color="Color.Primary"
                             Dense="true"
                             Label="Remember me" />

                <MudLink Href="/forgot-password" Color="Color.Primary" Class="app-login__forgot">
                    Forgot password?
                </MudLink>
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@(!CanSubmit)"
                       EndIcon="@(_submitting ? null : Icons.Material.Filled.ArrowForward)"
                       Class="app-login__submit">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In to Workspace</span>
                }
            </MudButton>

            <p class="app-login__footer">
                Don't have an account?
                <MudLink Href="/register" Color="Color.Primary"><b>Create one</b></MudLink>
            </p>
        </EditForm>
    </main>

</div>
