@page "/reset-password"
@layout EmptyLayout
@attribute [AllowAnonymous]

@* Where the link in the reset email lands. The email and token ride in the
   query string; the user supplies the new password. *@

<PageTitle>Set a new password - Orchestra</PageTitle>

<div class="app-login">

    <aside class="app-login__panel">
        <div class="app-login__brand">
            <AppBrand />
        </div>

        <div class="app-login__pitch">
            <h1 class="app-login__pitch-title">Set a new password</h1>
            <p class="app-login__pitch-body">
                Choose something you have not used here before. Signing in again afterwards
                also clears any lockout from failed attempts.
            </p>
        </div>
    </aside>

    <main class="app-login__form-side">
        @if (_done)
        {
            <div class="app-login__form" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle"
                         Color="Color.Success"
                         Size="Size.Large"
                         Class="mb-4" />

                <h2 class="app-login__title">Password changed</h2>
                <p class="app-login__subtitle">
                    You can sign in with your new password now.
                </p>

                <MudButton Href="/login"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="app-login__submit">
                    Go to sign in
                </MudButton>
            </div>
        }
        else
        {
            <EditForm class="app-login__form" Model="_model" OnValidSubmit="SubmitAsync">
                <h2 class="app-login__title">Choose a new password</h2>
                <p class="app-login__subtitle">For <b>@(Email ?? "your account")</b>.</p>

                @if (_formError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                        @_formError
                    </MudAlert>
                }

                <label class="app-login__label" for="password">New Password</label>
                <MudTextField @bind-Value="_model.NewPassword"
                              @bind-Value:after="ClearErrors"
                              id="password"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Choose a password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Lock"
                              Immediate="true"
                              Error="@(_passwordError is not null)"
                              ErrorText="@_passwordError"
                              HelperText="@PasswordRules.Description"
                              Class="app-login__input"
                              autocomplete="new-password" />

                <div class="app-login__reveal">
                    <MudIconButton Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                   Size="Size.Small"
                                   aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                   OnClick="TogglePassword" />
                </div>

                <label class="app-login__label" for="confirmPassword">Confirm New Password</label>
                <MudTextField @bind-Value="_model.ConfirmPassword"
                              @bind-Value:after="ClearErrors"
                              id="confirmPassword"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Type it again"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.LockReset"
                              Immediate="true"
                              Error="@(_confirmError is not null)"
                              ErrorText="@_confirmError"
                              Class="app-login__input"
                              autocomplete="new-password" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!CanSubmit)"
                           EndIcon="@(_submitting ? null : Icons.Material.Filled.ArrowForward)"
                           Class="app-login__submit">
                    @if (_submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Set New Password</span>
                    }
                </MudButton>

                <p class="app-login__footer">
                    Link expired?
                    <MudLink Href="/forgot-password" Color="Color.Primary"><b>Request a new one</b></MudLink>
                </p>
            </EditForm>
        }
    </main>

</div>
