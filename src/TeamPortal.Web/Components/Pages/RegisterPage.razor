@page "/register"
@layout EmptyLayout
@attribute [AllowAnonymous]

@* Registration. Same split layout as screen 01 so the two pages read as one
   flow - see docs/design/01-login-screen.png.

   A self-registered account is created unconfirmed and read-only. It cannot be
   used until the link in the confirmation email is clicked, and it cannot change
   anything until an administrator gives it a role. *@

<PageTitle>Create an account - Orchestra</PageTitle>

<div class="app-login">

    <aside class="app-login__panel">
        <div class="app-login__brand">
            <AppBrand />
        </div>

        <div class="app-login__pitch">
            <h1 class="app-login__pitch-title">
                Join your team's workspace
            </h1>
            <p class="app-login__pitch-body">
                Create an account to follow the processes your team runs on. We will email
                you a link to confirm your address before you can sign in.
            </p>
        </div>
    </aside>

    <main class="app-login__form-side">
        @if (_sent)
        {
            <div class="app-login__form" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead"
                         Color="Color.Primary"
                         Size="Size.Large"
                         Class="mb-4" />

                <h2 class="app-login__title">Check your inbox</h2>
                <p class="app-login__subtitle">
                    If <b>@_submittedEmail</b> can receive mail, a confirmation link is on its
                    way. The link works once and expires in 24 hours.
                </p>

                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-4">
                    Nothing arrived? Check the spam folder, then
                    <MudLink Href="/register" Color="Color.Primary"><b>try again</b></MudLink>.
                </MudAlert>

                <MudButton Href="/login"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="app-login__submit">
                    Back to sign in
                </MudButton>
            </div>
        }
        else
        {
            <EditForm class="app-login__form" Model="_model" OnValidSubmit="RegisterAsync">
                <h2 class="app-login__title">Create your account</h2>
                <p class="app-login__subtitle">It takes a minute. We will confirm your email first.</p>

                @if (_formError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                        @_formError
                    </MudAlert>
                }

                <label class="app-login__label" for="fullName">Full Name</label>
                <MudTextField @bind-Value="_model.FullName"
                              @bind-Value:after="ClearErrors"
                              id="fullName"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Sarah Ndlovu"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Person"
                              Immediate="true"
                              Error="@(_nameError is not null)"
                              ErrorText="@_nameError"
                              Class="app-login__input"
                              autocomplete="name" />

                <label class="app-login__label" for="email">Email Address</label>
                <MudTextField @bind-Value="_model.Email"
                              @bind-Value:after="ClearErrors"
                              id="email"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="name@company.com"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Email"
                              Immediate="true"
                              Error="@(_emailError is not null)"
                              ErrorText="@_emailError"
                              Class="app-login__input"
                              autocomplete="email" />

                <label class="app-login__label" for="password">Password</label>
                <MudTextField @bind-Value="_model.Password"
                              @bind-Value:after="ClearErrors"
                              id="password"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Choose a password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Lock"
                              Immediate="true"
                              Error="@(_passwordError is not null)"
                              ErrorText="@_passwordError"
                              HelperText="@PasswordRules.Description"
                              Class="app-login__input"
                              autocomplete="new-password" />

                <div class="app-login__reveal">
                    <MudIconButton Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                   Size="Size.Small"
                                   aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                   OnClick="TogglePassword" />
                </div>

                <label class="app-login__label" for="confirmPassword">Confirm Password</label>
                <MudTextField @bind-Value="_model.ConfirmPassword"
                              @bind-Value:after="ClearErrors"
                              id="confirmPassword"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Type it again"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.LockReset"
                              Immediate="true"
                              Error="@(_confirmError is not null)"
                              ErrorText="@_confirmError"
                              Class="app-login__input"
                              autocomplete="new-password" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!CanSubmit)"
                           EndIcon="@(_submitting ? null : Icons.Material.Filled.ArrowForward)"
                           Class="app-login__submit">
                    @if (_submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Creating your account...</span>
                    }
                    else
                    {
                        <span>Create Account</span>
                    }
                </MudButton>

                <p class="app-login__footer">
                    Already have an account?
                    <MudLink Href="/login" Color="Color.Primary"><b>Sign in</b></MudLink>
                </p>
            </EditForm>
        }
    </main>

</div>
