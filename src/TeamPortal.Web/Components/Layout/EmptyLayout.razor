@inherits LayoutComponentBase

@* Full-bleed layout with no app bar or drawer. Used by the login screen, which
   is a split purple/white page in the design and owns the whole viewport. *@

<MudThemeProvider Theme="AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
