# ******************************************************************************
# Purpose : Line endings. .editorconfig says end_of_line = crlf and CI gate 3
#           (`dotnet format --verify-no-changes`) enforces it, but `dotnet format`
#           only reaches .cs files - it leaves .razor alone. Without this file a
#           tool or editor that writes LF puts the build in a state the gate
#           rejects and nothing fixes automatically.
# Ticket  : SD-PENDING
# ******************************************************************************

# Normalise on commit, check out CRLF on every platform.
* text=auto eol=crlf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.snk binary
*.dll binary
*.exe binary

# Generated by `dotnet ef migrations add`. Marked so diffs collapse in review -
# read the SQL, not the C#.
src/TeamPortal.Infrastructure/Data/Migrations/** linguist-generated=true
